              <option value="">Choisir une idole...</option>
              ${this.gm.state.players.filter(p => p.id !== currentPlayer.id).map(p => `<option value="${p.id}">${p.name}</option>`).join('')}
            </select>
          </div>
        ` : '',
        'Cupidon': (currentPlayer) => currentPlayer ? `
          <div style="background:rgba(255,100,200,0.15); border:1px solid rgba(255,100,200,0.3); padding:12px; border-radius:6px; margin-top:12px;">
            <div style="font-weight:600; margin-bottom:8px; color:#ff64c8;"> Slectionner 2 amoureux:</div>
            <div style="display: flex; flex-direction: column; gap: 6px;">
              ${this.gm.state.players.filter(p => p.id !== currentPlayer.id).map(p => `
