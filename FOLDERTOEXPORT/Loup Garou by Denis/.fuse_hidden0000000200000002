  // ===== Ordre logique des rles pour la premire nuit =====
  // ===== ORDRE LINAIRE PREMIRE NUIT - 38 RLES =====
  // Rfrence: ORDRE_PREMIERE_NUIT.md
  // Cet ordre est L'ORDRE EXACT d'appel des rles  la premire nuit
  // Format: numrot de 1  38 avec priorits dcroissantes
  getFirstNightRoleOrder(selectedRoles, roles) {
    const roleOrder = [
      //  RLES CRITIQUES (actions immdiates)
      'Cupidon',              // 1 - Cre le couple d'amoureux
      'Enfant_Sauvage',       // 2 - Choisit son idole
      'Chien_Loup',           // 3 - Choisit Loup ou Villageois
      //  ACTIONS DE JOUR SPCIALES
      'Montreur_Ours',        // 4 - Rveille le voisin
      'Chevalier_Epee_Rouille', // 5 - Peut dfier
      //  ACTIONS NOCTURNES PRINCIPALES
      'Voyante',              // 6 - Vrifie rle
      'Sorciere',             // 7 - Potions vie/mort
      'Ancien',               // 8 - Protge
      'Ange',                 // 9 - Protge
      'Servante_Devouee',     // 10 - Protge (lie  victime)
      'Salvateur',            // 11 - Anticipe infection
      'Renard',               // 12 - Sent les loups
      'Gitane',               // 13 - Sent connexions
      'Joueur_Flute',         // 14 - Charme
      'Marionnettiste',       // 15 - Contrle
      'Voleur',               // 16 - Vole rle
      'Pyromane',             // 17 - Marque (3 = brle)
      'Ankou',                // 18 - Marque mort
      'Abominable_Sectaire',  // 19 - Convertit
      'Lapin_Blanc',          // 20 - vnements
      'Juge_Begue',           // 21 - Juge
      'Necromancien',         // 22 - Ressuscite
      'Noctambule',           // 23 - Agit nuit
      'Corbeau',              // 24 - Boost vote
      'Petite_Fille',         // 25 - coute loups
      //  RLES SPCIAUX PASSIFS
      'Idiot_Village',        // 26 - Immunis vote (sauf rvl)
      'Bouc_Emissaire',       // 27 - Meurt galit
      'Capitaine',            // 28 - Vote double
      'Chasseur',             // 29 - Peut tirer ( mort)
      //  LOUPS - SE CONNAISSENT
      'Simple_Loup_Garou',       // 30 - Loup normal
      'Grand_Mechant_Loup',      // 31 - Indtectable
      'Loup_Garou_Blanc',        // 32 - Tue un loup
      'Loup_Garou_Voyant',       // 33 - Voit tous rles
      'Infect_Pere_Loups',       // 34 - Infecte
      //  LIAISONS & PASSIFS
      'Deux_Soeurs',          // 35 - Liaison
      'Trois_Freres',         // 36 - Liaison
      'Comedien',             // 37 - Bluff pur
      'Villageois_Villageois' // 38 - Pas de pouvoir
    ];
    // Convertir en priorits bases sur la position
    const rolePriority = {};
    roleOrder.forEach((role, index) => {
      rolePriority[role] = 1000 - (index * 10); // 1000, 990, 980... etc
    });
    return selectedRoles.sort((a, b) => {
      const priorityA = rolePriority[a] ?? 0;
      const priorityB = rolePriority[b] ?? 0;
      return priorityB - priorityA;
    });
  }
