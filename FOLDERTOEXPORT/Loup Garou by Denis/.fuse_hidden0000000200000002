    document.querySelectorAll('.gm-role-card')?.forEach(card => {
      card.addEventListener('click', (e) => {
        const roleId = e.currentTarget.dataset.roleId;
        if (!this.gm.state.selectedRoles.includes(roleId)) {
          this.gm.state.selectedRoles.push(roleId);
        } else {
          this.gm.state.selectedRoles = this.gm.state.selectedRoles.filter(r => r !== roleId);
        }
        this.gm.saveState();
        this.render();
      });
    });
    document.getElementById('gmBtnStartGame')?.addEventListener('click', () => {
      if (this.gm.state.selectedRoles.length !== this.gm.state.players.length) {
        alert(`Slectionnez exactement ${this.gm.state.players.length} rles!`);
        return;
      }
      // Assigner les rles aux joueurs
      this.gm.state.players.forEach((player, idx) => {
        player.roleId = this.gm.state.selectedRoles[idx];
      });
      this.gm.startGame(this.gm.state.selectedRoles);
      this.gm.state.mode = 'playing';
      this.gm.saveState();
      this.render();
