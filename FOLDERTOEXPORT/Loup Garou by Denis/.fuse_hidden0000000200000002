        'Chien_Loup': (currentPlayer) => currentPlayer ? `
          <div style="background:rgba(150,100,255,0.15); border:1px solid rgba(150,100,255,0.3); padding:12px; border-radius:6px; margin-top:12px;">
            <div style="font-weight:600; margin-bottom:8px; color:#b464ff;"> Chien Loup - Devenir loup?</div>
            <select id="gmChienLoupSelect" style="width:100%; padding:8px; background:rgba(0,0,0,0.3); border:1px solid rgba(199,125,255,0.3); color:white; border-radius:4px;">
              <option value="villageois">Rester Villageois</option>
              <option value="loup">Devenir Loup-Garou</option>
            </select>
          </div>
        ` : ''
      };
      const currentPlayer = this.gm.state.players.find(p => p.roleId === currentRoleId);
      if (interactions[currentRoleId]) {
        interactionHtml = interactions[currentRoleId](currentPlayer) || '';
      }
    }
    console.log('[renderAssignRoles] Mode:', this.gm.state.mode, 'RoleIdx:', currentRoleIdx, 'Total:', orderedRoles.length);
    return `
      <div class="gm-screen gm-first-night" style="display:flex; flex-direction:column; height:100%; width:100%; gap:0; padding:0; margin:0;">
