// ========================================
// GAME MASTER UI - Interface & Rendering
// ========================================
class GameMasterUI {
  constructor(gameMaster) {
    this.gm = gameMaster;
    this.collapsed = false;
    this.minimized = false;
    console.log('[GameMaster UI] Constructor called');
    // Mapping des rles vers les fichiers WebP disponibles
    // Les cls doivent correspondre aux IDs de rles exact de game-master.js
    this.roleToCardFile = {
      'Villageois_Villageois': 'Villageois_Villageois',
      'Voyante': 'Voyante',
      'Chasseur': 'Chasseur',
      'Sorcire': 'Sorciere',
      'Cupidon': 'Cupidon',
      'Petite_Fille': 'Petite_Fille',
      'Ancien': 'Ancien',
      'Bouc_Emissaire': 'Bouc_Emissaire',
      'Corbeau': 'Corbeau',
      'Montreur_Ours': 'Montreur_Ours',
      'Salvateur': 'Salvateur',
      'Servante_Devouee': 'Servante_Devouee',
      'Idiot_Village': 'Idiot_Village',
      'Ange': 'Ange',
      'Capitaine': 'Capitaine',
      'Noctambule': 'Noctambule',
      'Simple_Loup_Garou': 'Simple_Loup_Garou',
      'Grand_Mechant_Loup': 'Grand_Mechant_Loup',
      'Loup_Garou_Blanc': 'Loup_Garou_Blanc',
      'Loup_Garou_Voyant': 'Loup_Garou_Voyant',
      'Infect_Pere_Loups': 'Infect_Pere_Loups',
      'Enfant_Sauvage': 'Enfant_Sauvage',
      'Renard': 'Renard',
      'Gitane': 'Gitane',
      'Joueur_Flute': 'Joueur_Flute',
      'Marionnettiste': 'Marionnettiste',
      'Voleur': 'Voleur',
      'Pyromane': 'Pyromane',
      'Deux_Soeurs': 'Deux_Soeurs',
      'Trois_Freres': 'Trois_Freres',
      'Ankou': 'Ankou',
      'Abominable_Sectaire': 'Abominable_Sectaire',
      'Lapin_Blanc': 'Lapin_Blanc',
      'Chevalier_Epee_Rouille': 'Chevalier_Epee_Rouille',
      'Chien_Loup': 'Chien_Loup',
      'Comedien': 'Comedien',
      'Juge_Begue': 'Juge_Begue',
      'Necromancien': 'Necromancien',
    };
    this.init();
  }
  getCardFile(roleId) {
    // Retourner le fichier mapp ou le fichier normalis
    if (this.roleToCardFile[roleId]) {
      return this.roleToCardFile[roleId];
    }
    // Fallback: normaliser les accents et caractres spciaux
    return roleId
      .normalize('NFD')
      .replace(/[-]/g, '') // Supprimer les accents
      .replace(/[\s-]/g, '_'); // Remplacer espaces et tirets par underscores
  }
  init() {
    console.log('[GameMaster UI] Init called');
    this.createOverlay();
    this.attachEventListeners();
    console.log('[GameMaster UI] Init complete');
  }
  createOverlay() {
    // Vrifier si l'overlay existe dj
    let overlay = document.getElementById('gameMasterOverlay');
    if (overlay) {
      console.log('[GameMaster] Overlay already exists, skipping creation');
      return;
    }
    // Crer le container principal de l'overlay
    overlay = document.createElement('div');
    overlay.id = 'gameMasterOverlay';
    overlay.className = 'game-master-overlay';
    overlay.innerHTML = `
      <div class="gm-header">
        <div class="gm-title"> Matre du Jeu</div>
        <div style="display: flex; gap: 4px;">
          <button class="gm-btn-reset" id="gmBtnReset" title="Rinitialiser le jeu"></button>
          <button class="gm-btn-collapse" id="gmBtnCollapse" title="Rduire"></button>
          <button class="gm-btn-close" id="gmBtnClose" title="Fermer"></button>
        </div>
      </div>
      <div class="gm-content" id="gmContent">
        <!-- Le contenu sera rendu ici dynamiquement -->
      </div>
      <div class="gm-resize-overlay" id="gmResizeOverlay" title="Glissez pour redimensionner"></div>
    `;
    document.body.appendChild(overlay);
    this.setupOverlayResize(overlay);
    console.log('[GameMaster] Overlay created');
  }
  attachEventListeners() {
    console.log('[GameMaster UI] Attaching event listeners');
    const header = document.querySelector('.gm-header');
    if (header) {
      console.log('[GameMaster UI] Header found, setting up dragging');
      this.setupDragging(header);
    } else {
      console.warn('[GameMaster UI] Header not found!');
    }
    document.getElementById('gmBtnReset')?.addEventListener('click', (e) => {
      console.log('[GameMaster UI] Reset button clicked');
      e.stopPropagation();
      if (confirm(' Rinitialiser le jeu? Tous les progrs seront perdus.')) {
        this.gm.resetState();
        this.gm.state.mode = 'setup';
        this.gm.saveState();
        this.render();
        console.log('[GameMaster] Jeu rinitialis');
      }
    });
    document.getElementById('gmBtnCollapse')?.addEventListener('click', (e) => {
      console.log('[GameMaster UI] Collapse button clicked, minimized =', this.minimized);
      e.stopPropagation();
      this.toggleMinimized();
    });
    document.getElementById('gmBtnClose')?.addEventListener('click', (e) => {
      console.log('[GameMaster UI] Close button clicked');
      e.stopPropagation();
      this.close();
    });
    console.log('[GameMaster UI] Event listeners attached');
  }
  setupDragging(header) {
    const overlay = document.getElementById('gameMasterOverlay');
    if (!overlay) return;
    let isDragging = false;
    let dragOffsetX = 0;
    let dragOffsetY = 0;
    header.addEventListener('mousedown', (e) => {
      // Ne pas draguer si on clique sur un bouton ou un input
      if (e.target.closest('button') || e.target.closest('input')) return;
      isDragging = true;
      const rect = overlay.getBoundingClientRect();
      dragOffsetX = e.clientX - rect.left;
      dragOffsetY = e.clientY - rect.top;
      header.style.cursor = 'grabbing';
    });
    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const newX = e.clientX - dragOffsetX;
      const newY = e.clientY - dragOffsetY;
      overlay.style.left = Math.max(0, Math.min(newX, window.innerWidth - overlay.offsetWidth)) + 'px';
      overlay.style.top = Math.max(0, Math.min(newY, window.innerHeight - overlay.offsetHeight)) + 'px';
      overlay.style.right = 'auto';
      overlay.style.bottom = 'auto';
    });
    document.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        header.style.cursor = 'grab';
      }
    });
  }
  render() {
    console.log('[GameMaster UI] render() called, mode =', this.gm.state.mode);
    const content = document.getElementById('gmContent');
    if (!content) {
      console.error('[GameMaster UI] gmContent element not found!');
      return;
    }
    const mode = this.gm.state.mode;
    let html = '';
    switch (mode) {
      case 'setup':
        console.log('[GameMaster UI] Rendering setup screen');
        html = this.renderSetup();
        break;
      case 'selectRoles':
        console.log('[GameMaster UI] Rendering role selection screen');
        html = this.renderSelectRoles();
        break;
      case 'players':
        console.log('[GameMaster UI] Rendering players screen');
        html = this.renderPlayers();
        break;
      case 'tableSetup':
        console.log('[GameMaster UI] Rendering table setup screen');
        html = this.renderTableSetup();
        break;
      case 'placePlayers':
        console.log('[GameMaster UI] Rendering place players screen');
        html = this.renderPlacePlayers();
        break;
      case 'assignRoles':
        console.log('[GameMaster UI] Rendering assign roles screen');
        html = this.renderAssignRoles();
        break;
      case 'roles':
        console.log('[GameMaster UI] Rendering roles screen');
        html = this.renderRoles();
        break;
      case 'playing':
        console.log('[GameMaster UI] Rendering game screen');
        html = this.renderGame();
        break;
      case 'history':
        console.log('[GameMaster UI] Rendering history screen');
        html = this.renderHistory();
        break;
      default:
        console.log('[GameMaster UI] Rendering default (setup) screen');
        html = this.renderSetup();
    }
    console.log('[GameMaster UI] Setting innerHTML, html length =', html.length);
    content.innerHTML = html;
    console.log('[GameMaster UI] Attaching dynamic listeners');
    this.attachDynamicListeners();
    // Initialiser drag-drop si en mode jeu, setup table ou placement des joueurs
    if (mode === 'playing') {
      setTimeout(() => this.setupTableDragDrop(), 0);
    } else if (mode === 'tableSetup') {
      setTimeout(() => this.setupTableSetupDragDrop(), 0);
    } else if (mode === 'placePlayers') {
      setTimeout(() => this.setupTableSetupDragDrop(), 0);
    }
  }
  // ===== SCREEN: SETUP =====
  renderSetup() {
    return `
      <div class="gm-screen">
        <h2>Bienvenue Matre du Jeu</h2>
        <p style="opacity:0.7; margin-bottom:16px;">Dmarrez une nouvelle partie de Loup-Garou!</p>
        <div class="gm-buttons">
          <button class="gm-btn-action" id="gmBtnNewGame"> Nouvelle Partie</button>
        </div>
        <hr style="margin:16px 0; opacity:0.2">
        <h3 style="color: var(--gm-border); margin-top:12px;"> Rgles du Jeu</h3>
        <div style="font-size:12px; opacity:0.8; line-height: 1.6;">
          <p><strong>Objectif:</strong> Loup-Garou est un jeu de dduction social o les Loups-Garous doivent liminer les villageois, tandis que les villageois doivent dcouvrir et liminer les Loups.</p>
          <p><strong>Phases du jeu:</strong></p>
          <ul style="margin:4px 0; padding-left:16px;">
            <li><strong> Phase de Nuit:</strong> Les rles actifs jouent leurs pouvoirs (Loups attaquent, Voyante devine, etc.)</li>
            <li><strong> Phase de Jour:</strong> Tous les joueurs dbattent et votent pour liminer quelqu'un</li>
          </ul>
          <p><strong>Victoire:</strong></p>
          <ul style="margin:4px 0; padding-left:16px;">
            <li> <strong>Loups gagnent</strong> quand tous les villageois sont morts</li>
            <li> <strong>Villageois gagnent</strong> quand tous les Loups sont morts</li>
          </ul>
        </div>
      </div>
    `;
  }
  // ===== SCREEN: SELECT ROLES =====
  renderSelectRoles() {
    const allRoles = Object.entries(this.gm.roles);
    // Catgories personnalises
    const categoryOrder = ['Villageois', 'Loups', 'Spcial'];
    const grouped = {};
    // Initialiser les catgories
    categoryOrder.forEach(cat => { grouped[cat] = []; });
    // Distribuer les rles
    allRoles.forEach(([id, role]) => {
      const cat = role.category || 'Spcial';
      if (!grouped[cat]) grouped[cat] = [];
      grouped[cat].push([id, role]);
    });
    let rolesList = '';
    categoryOrder.forEach(category => {
      if (grouped[category].length === 0) return;
      const categoryEmoji = {
        'Villageois': '',
        'Loups': '',
        'Spcial': ''
      };
      rolesList += `
        <div class="gm-role-category">
          <h4 style="font-size:13px; margin:6px 0 6px 0; color: var(--gm-border); font-weight:700;">${categoryEmoji[category]} ${category}</h4>
          <div class="gm-role-grid" style="grid-template-columns: repeat(auto-fill, minmax(65px, 1fr)); gap:8px; margin-bottom:8px;">
            ${grouped[category].map(([id, role]) => {
              const cardFile = this.getCardFile(id);
              const cardImg = `cards/${cardFile}.webp`;
              const description = (role.description || 'Aucune description')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
              return `
                <div class="gm-role-card-new" data-role-id="${id}" data-description="${description}">
                  <img src="${cardImg}" alt="${id}" class="gm-card-img" onerror="this.style.opacity='0.3'">
                  <div class="gm-card-label">${id}</div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    });
    // Construire le deck (cartes slectionnes) - groupe les rles identiques
    const roleCount = {};
    this.gm.state.selectedRoles.forEach(roleId => {
      roleCount[roleId] = (roleCount[roleId] || 0) + 1;
    });
    const deckCards = Object.entries(roleCount).map(([roleId, count]) => {
      const cardFile = this.getCardFile(roleId);
      const cardImg = `cards/${cardFile}.webp`;
      return `
        <div class="gm-deck-card" data-deck-role-id="${roleId}" style="position:relative; width:50px; height:70px; margin:4px; cursor:pointer; opacity:0.9; transition:opacity 0.2s;">
          <img src="${cardImg}" alt="${roleId}" style="width:100%; height:100%; object-fit:contain; border-radius:4px; border:1px solid var(--gm-border); padding:1px; background:rgba(0,0,0,0.2);" onerror="this.style.opacity='0.3'">
          ${count > 1 ? `<div style="position:absolute; bottom:-8px; left:50%; transform:translateX(-50%); background:rgba(199,125,255,0.9); color:#fff; font-size:11px; font-weight:bold; padding:2px 6px; border-radius:3px; white-space:nowrap;">${count}</div>` : ''}
        </div>
      `;
    }).join('');
    return `
      <div class="gm-screen" style="display:flex; flex-direction:column; height:100%;">
        <h2 style="margin-bottom:4px;"> Slectionner les Rles</h2>
        <p style="opacity:0.7; font-size:12px; margin-bottom:4px;">Cliquez sur les cartes pour les ajouter  votre deck</p>
        <div class="gm-roles-container" style="flex:1; overflow-y:auto; margin-bottom:6px;">
          ${rolesList}
        </div>
        <hr style="opacity:0.2; margin:4px 0;">
        <div style="background:rgba(0,0,0,0.3); border:1px solid var(--gm-border); border-radius:6px; padding:8px;">
          <div style="font-size:11px; margin-bottom:4px; opacity:0.8;"><strong>Deck (${this.gm.state.selectedRoles.length}):</strong></div>
          <div style="display:flex; flex-wrap:wrap; align-items:flex-start; height:80px; background:rgba(255,255,255,0.02); padding:6px; border-radius:4px; overflow-y:auto;">
            ${deckCards || '<span style="opacity:0.5; font-size:11px;">Cartes ajoutes ici...</span>'}
          </div>
        </div>
        <div class="gm-buttons" style="margin-top:6px;">
          <button class="gm-btn-secondary" id="gmBtnBackSelectRoles"> Retour</button>
          <button class="gm-btn-action" id="gmBtnContinuePlayers" ${this.gm.state.selectedRoles.length < 2 ? 'disabled style="opacity:0.5; cursor:not-allowed;"' : ''}>Suivant: Joueurs </button>
        </div>
      </div>
    `;
  }
  // ===== SCREEN: PLAYERS =====
  renderPlayers() {
    const players = this.gm.state.players;
    const cardsCount = this.gm.state.selectedRoles.length;
    const playerVignettes = players.map((p, idx) => `
      <div class="gm-player-vignette">
        <div style="font-size:28px; margin-bottom:8px;"></div>
        <input type="text" class="gm-player-name-input" value="${p.name}" data-player-id="${p.id}" placeholder="Nom..." style="width:100%; text-align:center; margin-bottom:6px;">
        <button class="gm-btn-remove" data-player-id="${p.id}" style="width:100%;">Retirer</button>
      </div>
    `).join('');
    const isMatched = players.length === cardsCount;
    const statusColor = isMatched ? '#4ade80' : '#f87171';
    const statusText = isMatched ? ' OK' : ` Besoin de ${cardsCount} joueurs`;
    return `
      <div class="gm-screen">
        <h2>Joueurs <span style="color: ${statusColor}; font-size: 14px;">${players.length}/${cardsCount}</span></h2>
        <p style="opacity:0.7; font-size:12px;">Nommez vos ${cardsCount} joueurs</p>
        <div style="background:rgba(${isMatched ? '74,222,128' : '248,113,113'},0.15); border:1px solid rgba(${isMatched ? '74,222,128' : '248,113,113'},0.3); padding:8px; border-radius:6px; margin-bottom:12px; font-size:13px; color:rgba(255,255,255,0.9);">
          ${statusText}
        </div>
        <div class="gm-players-grid">
          ${playerVignettes}
        </div>
        <div style="margin-top:12px; padding:8px; background:rgba(255,255,255,0.05); border-radius:4px; font-size:11px; opacity:0.6;">
           Chaque joueur reoit une carte. ${cardsCount} joueurs = ${cardsCount} cartes
        </div>
        <div class="gm-buttons" style="margin-top:12px;">
          <button class="gm-btn-secondary" id="gmBtnBackPlayers"> Retour</button>
          <button class="gm-btn-action" id="gmBtnContinueRoles">Suivant: Table </button>
        </div>
      </div>
    `;
  }
  // ===== SCREEN: TABLE SETUP (Choix du type de table avec 6 prsets) =====
  renderTableSetup() {
    const tableType = this.gm.state.tableType || 'circle';
    const playerCount = this.gm.state.players.length;
    // 6 prsets de tables avec leurs dimensions
    const tablePresets = {
      'circle': { label: ' Ronde', width: 280, height: 280, radius: 140 },
      'oval-v': { label: ' Ovale Verticale', width: 200, height: 320, rx: 100, ry: 160 },
      'oval-h': { label: ' Ovale Horizontale', width: 340, height: 200, rx: 170, ry: 100 },
      'rect-v': { label: ' Rectangle Verticale', width: 180, height: 340 },
      'rect-h': { label: ' Rectangle Horizontale', width: 360, height: 180 },
      'square': { label: ' Carr', width: 260, height: 260 }
    };
    const presetOptions = Object.entries(tablePresets).map(([type, preset]) => {
      const isSelected = tableType === type;
      let previewSvg = '';
      if (type === 'circle') {
        previewSvg = `<svg width="100" height="100" viewBox="0 0 120 120" style="margin:0 auto; display:block;"><circle cx="60" cy="60" r="45" fill="rgba(120,85,60,0.4)" stroke="rgba(199,125,255,0.5)" stroke-width="2"/></svg>`;
      } else if (type === 'oval-v') {
        previewSvg = `<svg width="80" height="110" viewBox="0 0 100 140" style="margin:0 auto; display:block;"><ellipse cx="50" cy="70" rx="35" ry="55" fill="rgba(120,85,60,0.4)" stroke="rgba(199,125,255,0.5)" stroke-width="2"/></svg>`;
      } else if (type === 'oval-h') {
        previewSvg = `<svg width="110" height="80" viewBox="0 0 140 100" style="margin:0 auto; display:block;"><ellipse cx="70" cy="50" rx="55" ry="35" fill="rgba(120,85,60,0.4)" stroke="rgba(199,125,255,0.5)" stroke-width="2"/></svg>`;
      } else if (type === 'rect-v') {
        previewSvg = `<svg width="75" height="110" viewBox="0 0 90 140" style="margin:0 auto; display:block;"><rect x="10" y="20" width="70" height="100" fill="rgba(120,85,60,0.4)" stroke="rgba(199,125,255,0.5)" stroke-width="2"/></svg>`;
      } else if (type === 'rect-h') {
        previewSvg = `<svg width="110" height="75" viewBox="0 0 140 90" style="margin:0 auto; display:block;"><rect x="20" y="10" width="100" height="70" fill="rgba(120,85,60,0.4)" stroke="rgba(199,125,255,0.5)" stroke-width="2"/></svg>`;
      } else if (type === 'square') {
        previewSvg = `<svg width="100" height="100" viewBox="0 0 130 130" style="margin:0 auto; display:block;"><rect x="15" y="15" width="100" height="100" fill="rgba(120,85,60,0.4)" stroke="rgba(199,125,255,0.5)" stroke-width="2"/></svg>`;
      }
      return `
        <div class="gm-table-preset" data-table-type="${type}" style="flex:1; cursor:pointer; padding:10px; border-radius:6px; border:${isSelected ? '3px solid #81dff7' : '2px solid rgba(199,125,255,0.3)'}; background:rgba(0,0,0,0.3); transition:all 0.2s; text-align:center;">
          <div style="font-weight:600; margin-bottom:6px; color:${isSelected ? '#81dff7' : '#e8e8f0'}; font-size:12px;">${preset.label}</div>
          ${previewSvg}
        </div>
      `;
    }).join('');
    return `
      <div class="gm-screen" style="display:flex; flex-direction:column; height:100%; gap:0; padding:0;">
        <h2 style="padding:12px 16px; margin:0; border-bottom:2px solid rgba(199,125,255,0.3); background:linear-gradient(135deg, rgba(25,25,45,0.95), rgba(35,30,55,0.95)); font-size:18px; color:#e8e8f0;">
           Choisir la Table (${playerCount} joueurs)
        </h2>
        <div style="flex:1; padding:12px 16px; display:flex; flex-direction:column; gap:12px; background:linear-gradient(135deg, rgba(20,25,45,0.9), rgba(30,35,55,0.9)); color:#e8e8f0; overflow:hidden;">
          <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:8px;">
            ${presetOptions}
          </div>
          <!-- BOUTONS -->
          <div style="display:flex; gap:8px; margin-top:8px;">
            <button class="gm-btn-secondary" id="gmBtnBackTableSetup" style="background:rgba(255,255,255,0.1); border:1px solid rgba(199,125,255,0.3); padding:10px 12px; border-radius:6px; color:#e8e8f0; font-weight:600; font-size:13px; cursor:pointer; flex:1;">
               Retour
            </button>
            <button class="gm-btn-action" id="gmBtnTableSetupDone" style="background:linear-gradient(135deg, #5174db, #c77dff); border:none; padding:10px 12px; border-radius:6px; color:white; font-weight:600; font-size:13px; cursor:pointer; flex:1;">
               Placer les Joueurs
            </button>
          </div>
        </div>
      </div>
    `;
  }
  // ===== SCREEN: PLACE PLAYERS (Positionnement des joueurs autour de la table) =====
  renderPlacePlayers() {
    const players = this.gm.state.players;
    const tableType = this.gm.state.tableType || 'circle';
    const tablePresets = {
      'circle': { width: 140, height: 140 },
      'oval-v': { width: 100, height: 160 },
      'oval-h': { width: 170, height: 100 },
      'rect-v': { width: 90, height: 170 },
      'rect-h': { width: 180, height: 90 },
      'square': { width: 130, height: 130 }
    };
    const preset = tablePresets[tableType];
    const tableWidth = preset.width;
    const tableHeight = preset.height;
    const result = this.generatePositionsByTableType(players.length, tableType);
    const defaultPositions = result.positions;
    players.forEach((p, idx) => {
      if (!p.tableX || !p.tableY) {
        if (defaultPositions[idx]) {
          p.tableX = defaultPositions[idx].x;
          p.tableY = defaultPositions[idx].y;
          this.gm.saveState();
        }
      }
    });
    const playerPoints = players.map((p) => `
      <div class="gm-player-point" data-player-id="${p.id}" style="left: ${p.tableX}px; top: ${p.tableY}px;" draggable="true" title="${p.name}">
        <div class="gm-point-dot"></div>
        <div class="gm-point-name">${p.name}</div>
      </div>
    `).join('');
    const playerNamesHtml = players.map((p, idx) => `
      <div style="display:flex; flex-direction:column; align-items:center; gap:8px; padding:12px; background:rgba(0,0,0,0.2); border-radius:6px; border:1px solid rgba(199,125,255,0.2);">
        <div style="font-size:11px; opacity:0.7; text-align:center; font-weight:600;">Joueur ${idx + 1}</div>
        <input type="text" class="gm-player-name-input-place" data-player-id="${p.id}" value="${p.name}" placeholder="Nom..." style="width:95%; padding:6px; border:1px solid rgba(199,125,255,0.3); background:rgba(0,0,0,0.4); border-radius:4px; color:#e8e8f0; text-align:center; font-size:12px;">
      </div>
    `).join('');
    let tableStyle = `position:relative; width:${tableWidth}px; height:${tableHeight}px; margin:0 auto; background:rgba(120, 85, 60, 0.6); border:3px solid var(--gm-border); box-shadow:inset 0 2px 8px rgba(0,0,0,0.5);`;
