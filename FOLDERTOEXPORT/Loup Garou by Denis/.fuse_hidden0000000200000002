    if (!this.gm.state.firstNightState) {
      // RINITIALISER tous les rles des joueurs au dbut de la premire nuit
      players.forEach(p => p.roleId = null);
      // Trier les rles selon l'ordre logique
      const orderedRoles = this.getFirstNightRoleOrder(this.gm.state.selectedRoles, this.gm.roles);
      this.gm.state.firstNightState = {
        orderedRoles: orderedRoles,
        currentRoleIdx: 0,
        selectedPlayer: null,
        interactions: {},
        completed: false,
      };
      this.gm.saveState();
    }
    // Si la premire nuit est termine, afficher le jour
    if (this.gm.state.firstNightState.completed) {
      return this.renderDay();
    }
    const state = this.gm.state.firstNightState;
    const orderedRoles = state.orderedRoles || this.getFirstNightRoleOrder(this.gm.state.selectedRoles, this.gm.roles);
    const currentRoleId = orderedRoles[state.currentRoleIdx];
