    const preset = tablePresets[tableType];
    const tableWidth = preset.width;
    const tableHeight = preset.height;
    console.log('[renderAssignRoles] Table size:', tableWidth, 'x', tableHeight);
    // Initialiser l'tat de la premire nuit
    if (!this.gm.state.firstNightState) {
      // RINITIALISER tous les rles des joueurs au dbut de la premire nuit
      players.forEach(p => p.roleId = null);
      // Trier les rles selon l'ordre logique
      const orderedRoles = this.getFirstNightRoleOrder(this.gm.state.selectedRoles, this.gm.roles);
      this.gm.state.firstNightState = {
        orderedRoles: orderedRoles,
        currentRoleIdx: 0,
        selectedPlayer: null,
        interactions: {},
        completed: false,
      };
      this.gm.saveState();
    }
    // Trier les rles selon l'ordre logique
    const orderedRoles = this.gm.state.firstNightState.orderedRoles || this.getFirstNightRoleOrder(this.gm.state.selectedRoles, this.gm.roles);
    const currentRoleIdx = this.gm.state.firstNightState.currentRoleIdx || 0;
    const currentRoleId = orderedRoles[currentRoleIdx];
    const currentRole = this.gm.roles[currentRoleId];
