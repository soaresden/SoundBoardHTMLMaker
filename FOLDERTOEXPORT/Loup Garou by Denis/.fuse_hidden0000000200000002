      this.gm.state.mode = 'selectRoles';
      this.gm.saveState();
      this.render();
    });
    document.getElementById('gmBtnBackRoles')?.addEventListener('click', () => {
      this.gm.state.mode = 'players';
      this.gm.saveState();
      this.render();
    });
    document.getElementById('gmBtnHistory')?.addEventListener('click', () => {
      this.gm.state.mode = 'history';
      this.gm.saveState();
      this.render();
    });
    document.getElementById('gmBtnBackHistory')?.addEventListener('click', () => {
      this.gm.state.mode = 'playing';
      this.gm.saveState();
      this.render();
    });
    // === TABLE SETUP (Slection des prsets) ===
    // Slectionner le type de table (prsets)
    document.querySelectorAll('.gm-table-preset')?.forEach(preset => {
      preset.addEventListener('click', () => {
        const tableType = preset.dataset.tableType;
        this.gm.state.tableType = tableType;
        this.gm.saveState();
        this.render();
      });
