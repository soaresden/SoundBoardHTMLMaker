        self.gm.saveState();
        // Table  taille FIXE - pas de zoom auto!
        // setTimeout(() => self.applyTableAutozoom(), 0);
      }
    });
  }
  setupOverlayResize(overlay) {
    const resizeHandle = overlay.querySelector('.gm-resize-overlay');
    if (!resizeHandle) return;
    let isResizingOverlay = false;
    let startX = 0;
    let startY = 0;
    let startWidth = 0;
    let startHeight = 0;
    resizeHandle.addEventListener('mousedown', (e) => {
      isResizingOverlay = true;
      startX = e.clientX;
      startY = e.clientY;
      startWidth = overlay.offsetWidth;
      startHeight = overlay.offsetHeight;
      resizeHandle.style.opacity = '1';
      e.preventDefault();
    });
    resizeHandle.addEventListener('mouseenter', () => {
      resizeHandle.style.opacity = '0.8';
    });
    resizeHandle.addEventListener('mouseleave', () => {
      if (!isResizingOverlay) {
        resizeHandle.style.opacity = '0.3';
      }
    });
    document.addEventListener('mousemove', (e) => {
      if (!isResizingOverlay) return;
      const deltaX = e.clientX - startX;
      const deltaY = e.clientY - startY;
      const newWidth = Math.max(400, startWidth + deltaX);
      const newHeight = Math.max(300, startHeight + deltaY);
      overlay.style.width = newWidth + 'px';
      overlay.style.height = newHeight + 'px';
    });
    document.addEventListener('mouseup', () => {
      if (isResizingOverlay) {
        resizeHandle.style.opacity = '0.3';
      }
      isResizingOverlay = false;
    });
  }
  setupTableSetupDragDrop() {
    const points = document.querySelectorAll('.gm-player-point');
    const container = document.getElementById('gmPlayersContainer');
    if (!container) return;
    let draggedPoint = null;
    let draggedPlayerId = null;
    let offsetX = 0;
    let offsetY = 0;
    points.forEach(point => {
      point.addEventListener('dragstart', (e) => {
        draggedPoint = point;
        draggedPlayerId = point.dataset.playerId;
        const rect = point.getBoundingClientRect();
        const containerRect = container.getBoundingClientRect();
        offsetX = e.clientX - rect.left;
        offsetY = e.clientY - rect.top;
        e.dataTransfer.effectAllowed = 'move';
        point.style.opacity = '0.5';
      });
      point.addEventListener('dragend', () => {
        point.style.opacity = '1';
        draggedPoint = null;
        draggedPlayerId = null;
      });
    });
    container.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
    });
    container.addEventListener('drop', (e) => {
      e.preventDefault();
      if (!draggedPoint || !draggedPlayerId) return;
      const rect = container.getBoundingClientRect();
      const x = e.clientX - rect.left - offsetX;
      const y = e.clientY - rect.top - offsetY;
      // Permettre les positions autour de la table (dans le conteneur)
      const maxX = rect.width - 16;
      const maxY = rect.height - 16;
      const finalX = Math.max(0, Math.min(x, maxX));
      const finalY = Math.max(0, Math.min(y, maxY));
      draggedPoint.style.left = `${finalX}px`;
      draggedPoint.style.top = `${finalY}px`;
      // Sauvegarder la position du joueur
      const player = this.gm.state.players.find(p => p.id === draggedPlayerId);
      if (player) {
        player.tableX = finalX;
        player.tableY = finalY;
        this.gm.saveState();
      }
    });
  }
  showPlayerActions(playerId) {
    const player = this.gm.state.players.find(p => p.id === playerId);
    const role = this.gm.getPlayerRole(playerId);
    if (!player || !role) return;
    const instruction = this.gm.state.nightPhase ? role.nightInstruction : role.dayInstruction;
    const instructionBox = document.getElementById('gmInstruction');
    if (instructionBox) {
      instructionBox.innerHTML = `
        <strong>${player.name} (${role.category})</strong><br>
        ${instruction}
      `;
    }
  }
  toggleMinimized() {
    const overlay = document.getElementById('gameMasterOverlay');
    if (!overlay) {
      console.error('[GameMaster UI] Overlay not found for toggleMinimized');
      return;
    }
    this.minimized = !this.minimized;
    console.log('[GameMaster UI] toggleMinimized, new state =', this.minimized);
    if (this.minimized) {
      // Sauvegarder la position actuelle avant rduction
      const computed = window.getComputedStyle(overlay);
      overlay.dataset.savedLeft = computed.left;
      overlay.dataset.savedTop = computed.top;
      overlay.dataset.savedWidth = computed.width;
      overlay.dataset.savedHeight = computed.height;
      console.log('[GameMaster UI] Saved position:', overlay.dataset.savedLeft, overlay.dataset.savedTop);
      // Rduire en bas  gauche
      overlay.classList.add('minimized');
    } else {
      // Restaurer la position
      overlay.classList.remove('minimized');
      overlay.style.left = overlay.dataset.savedLeft || '320px';
      overlay.style.top = overlay.dataset.savedTop || '100px';
      overlay.style.width = overlay.dataset.savedWidth || '650px';
      overlay.style.height = overlay.dataset.savedHeight || '650px';
      console.log('[GameMaster UI] Restored position');
    }
  }
  close() {
    const overlay = document.getElementById('gameMasterOverlay');
    if (overlay) {
      console.log('[GameMaster UI] Closing overlay');
      overlay.style.display = 'none';
    }
  }
  show() {
    const overlay = document.getElementById('gameMasterOverlay');
    if (overlay) {
      console.log('[GameMaster UI] Showing overlay');
      overlay.style.display = 'block';
    }
  }
}
// Export
if (typeof module !== 'undefined' && module.exports) {
  module.exports = GameMasterUI;
}
