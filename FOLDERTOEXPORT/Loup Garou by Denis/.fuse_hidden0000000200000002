  // Gnrer les positions selon le type de table
  // Retourne { positions: [], center: {x, y} }
  generatePositionsByTableType(count, tableType) {
    const positions = [];
    let centerX, centerY;
    if (tableType === 'circle') {
      // Ronde: positions sur un cercle
      const radius = 100;
      centerX = 150;
      centerY = 150;
      for (let i = 0; i < count; i++) {
        const angle = (i / count) * 2 * Math.PI - Math.PI / 2;
        const x = centerX + radius * Math.cos(angle);
        const y = centerY + radius * Math.sin(angle);
        positions.push({ x: Math.round(x), y: Math.round(y) });
      }
    } else if (tableType === 'oval-v') {
      // Ovale verticale
      const rx = 60;
      const ry = 120;
      centerX = 100;
      centerY = 160;
      for (let i = 0; i < count; i++) {
        const angle = (i / count) * 2 * Math.PI - Math.PI / 2;
        const x = centerX + rx * Math.cos(angle);
        const y = centerY + ry * Math.sin(angle);
        positions.push({ x: Math.round(x), y: Math.round(y) });
      }
    } else if (tableType === 'oval-h') {
      // Ovale horizontale
      const rx = 130;
      const ry = 70;
      centerX = 170;
      centerY = 100;
      for (let i = 0; i < count; i++) {
        const angle = (i / count) * 2 * Math.PI - Math.PI / 2;
        const x = centerX + rx * Math.cos(angle);
        const y = centerY + ry * Math.sin(angle);
        positions.push({ x: Math.round(x), y: Math.round(y) });
      }
    } else if (tableType === 'rect-v') {
      // Rectangle verticale
      const width = 90;
      const height = 200;
      centerX = 90;
      centerY = 170;
      const perimeter = 2 * (width + height);
      const spacing = perimeter / count;
      for (let i = 0; i < count; i++) {
        const distance = i * spacing;
        let x, y;
        if (distance < width) {
          x = centerX - width / 2 + distance;
          y = centerY - height / 2;
        } else if (distance < width + height) {
          x = centerX + width / 2;
          y = centerY - height / 2 + (distance - width);
        } else if (distance < 2 * width + height) {
          x = centerX + width / 2 - (distance - width - height);
          y = centerY + height / 2;
        } else {
          x = centerX - width / 2;
          y = centerY + height / 2 - (distance - 2 * width - height);
        }
        positions.push({ x: Math.round(x), y: Math.round(y) });
      }
    } else if (tableType === 'rect-h') {
      // Rectangle horizontale
      const width = 220;
      const height = 100;
      centerX = 180;
      centerY = 90;
      const perimeter = 2 * (width + height);
      const spacing = perimeter / count;
      for (let i = 0; i < count; i++) {
        const distance = i * spacing;
        let x, y;
        if (distance < width) {
          x = centerX - width / 2 + distance;
          y = centerY - height / 2;
        } else if (distance < width + height) {
          x = centerX + width / 2;
          y = centerY - height / 2 + (distance - width);
        } else if (distance < 2 * width + height) {
          x = centerX + width / 2 - (distance - width - height);
          y = centerY + height / 2;
        } else {
          x = centerX - width / 2;
          y = centerY + height / 2 - (distance - 2 * width - height);
        }
        positions.push({ x: Math.round(x), y: Math.round(y) });
      }
    } else if (tableType === 'square') {
      // Carr
      const size = 180;
      centerX = 130;
      centerY = 130;
      const perimeter = 4 * size;
      const spacing = perimeter / count;
      for (let i = 0; i < count; i++) {
        const distance = i * spacing;
        let x, y;
        if (distance < size) {
          x = centerX - size / 2 + distance;
          y = centerY - size / 2;
        } else if (distance < size + size) {
          x = centerX + size / 2;
          y = centerY - size / 2 + (distance - size);
        } else if (distance < 2 * size + size) {
          x = centerX + size / 2 - (distance - size - size);
          y = centerY + size / 2;
        } else {
          x = centerX - size / 2;
          y = centerY + size / 2 - (distance - 2 * size - size);
        }
        positions.push({ x: Math.round(x), y: Math.round(y) });
      }
    }
    return { positions, center: { x: centerX, y: centerY } };
  }
  generateCirclePositions(count, tableSize) {
    const positions = [];
    const centerX = tableSize / 2;
    const centerY = tableSize / 2;
    const radius = tableSize / 3;
    for (let i = 0; i < count; i++) {
      const angle = (i / count) * 2 * Math.PI - Math.PI / 2;
      const x = centerX + radius * Math.cos(angle) - 35;
      const y = centerY + radius * Math.sin(angle) - 35;
      positions.push({ x: Math.round(x), y: Math.round(y) });
    }
    return positions;
  }
  generateSquarePositions(count, tableSize) {
    const positions = [];
    const padding = tableSize / 6;
    const sideLength = tableSize - 2 * padding;
    const perimeter = 4 * sideLength;
    const spacing = perimeter / count;
    for (let i = 0; i < count; i++) {
      const distance = i * spacing;
      let x, y;
      if (distance < sideLength) {
        // Top side
        x = padding + distance;
        y = padding;
      } else if (distance < 2 * sideLength) {
        // Right side
        x = padding + sideLength;
        y = padding + (distance - sideLength);
      } else if (distance < 3 * sideLength) {
        // Bottom side
        x = padding + sideLength - (distance - 2 * sideLength);
        y = padding + sideLength;
      } else {
        // Left side
        x = padding;
        y = padding + sideLength - (distance - 3 * sideLength);
      }
      positions.push({ x: Math.round(x) - 35, y: Math.round(y) - 35 });
    }
    return positions;
  }
  generateOvalPositions(count, tableSize) {
    const positions = [];
    const centerX = tableSize / 2;
    const centerY = tableSize / 2;
    const radiusX = tableSize / 2.8;
    const radiusY = tableSize / 2.2;
    for (let i = 0; i < count; i++) {
      const angle = (i / count) * 2 * Math.PI - Math.PI / 2;
      const x = centerX + radiusX * Math.cos(angle) - 35;
      const y = centerY + radiusY * Math.sin(angle) - 35;
      positions.push({ x: Math.round(x), y: Math.round(y) });
    }
    return positions;
  }
  generateRectanglePositions(count, tableWidth, tableHeight) {
    const positions = [];
    const padding = Math.min(tableWidth, tableHeight) / 6;
    const rectWidth = tableWidth - 2 * padding;
    const rectHeight = tableHeight - 2 * padding;
    const perimeter = 2 * (rectWidth + rectHeight);
    const spacing = perimeter / count;
    for (let i = 0; i < count; i++) {
      const distance = i * spacing;
      let x, y;
      if (distance < rectWidth) {
        // Top side
        x = padding + distance;
        y = padding;
      } else if (distance < rectWidth + rectHeight) {
        // Right side
        x = padding + rectWidth;
        y = padding + (distance - rectWidth);
      } else if (distance < 2 * rectWidth + rectHeight) {
        // Bottom side
        x = padding + rectWidth - (distance - rectWidth - rectHeight);
        y = padding + rectHeight;
      } else {
        // Left side
        x = padding;
        y = padding + rectHeight - (distance - 2 * rectWidth - rectHeight);
      }
      positions.push({ x: Math.round(x) - 35, y: Math.round(y) - 35 });
    }
    return positions;
  }
