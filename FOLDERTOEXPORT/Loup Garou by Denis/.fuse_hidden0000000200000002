  // ===== PHASE: JOUR (Vote & liminations) =====
  renderDay() {
    const players = this.gm.state.players;
    const tableShape = this.gm.state.tableShape || 'circle';
    const tableWidth = this.gm.state.tableWidth || 300;
    const tableHeight = this.gm.state.tableHeight || 300;
    const turn = this.gm.state.currentTurn;
    // Cartes des joueurs
    const playerCards = players.map((p) => {
      const role = this.gm.roles[p.roleId];
      const isDead = p.isDead;
      const cardFile = this.getCardFile(p.roleId || 'Unknown');
      const cardImg = `cards/${cardFile}.webp`;
      return `
        <div class="gm-day-player-card ${isDead ? 'dead' : ''}"
             data-player-id="${p.id}"
             style="left: ${p.tableX}px; top: ${p.tableY}px; cursor: ${isDead ? 'default' : 'pointer'}; opacity: ${isDead ? '0.4' : '1'};">
          <div style="position:relative; width:100%; height:100%; transition:all 0.3s;">
            <img src="${cardImg}" alt="${p.roleId}" style="width:100%; height:100%; object-fit:cover; border-radius:6px;">
            ${isDead ? '<div style="position:absolute; inset:0; background:rgba(0,0,0,0.6); border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:28px;"></div>' : ''}
