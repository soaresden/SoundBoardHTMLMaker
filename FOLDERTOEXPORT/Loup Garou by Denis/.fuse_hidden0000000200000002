    const tablePresets = {
      'circle': { width: 140, height: 140 },
      'oval-v': { width: 100, height: 160 },
      'oval-h': { width: 170, height: 100 },
      'rect-v': { width: 90, height: 170 },
      'rect-h': { width: 180, height: 90 },
      'square': { width: 130, height: 130 }
