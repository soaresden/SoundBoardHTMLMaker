      this.gm.state.mode = 'selectRoles';
      this.gm.saveState();
      this.render();
    });
    // Bouton "Placer les Joueurs"
    document.getElementById('gmBtnTableSetupDone')?.addEventListener('click', () => {
      // Vrifier qu'on a slectionn des rles
      if (this.gm.state.selectedRoles.length === 0) {
        alert('Vous devez d\'abord slectionner des rles!');
        return;
      }
      // Vrifier qu'on a choisi une table
