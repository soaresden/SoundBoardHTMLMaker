  setupTableDragDrop() {
    const cards = document.querySelectorAll('.gm-table-card');
    const table = document.getElementById('gmTable');
    if (!table) return;
    let draggedCard = null;
    let offsetX = 0;
    let offsetY = 0;
    cards.forEach(card => {
      card.addEventListener('dragstart', (e) => {
        draggedCard = card;
        const rect = card.getBoundingClientRect();
        const tableRect = table.getBoundingClientRect();
        offsetX = e.clientX - rect.left;
        offsetY = e.clientY - rect.top;
        e.dataTransfer.effectAllowed = 'move';
        card.style.opacity = '0.6';
      });
      card.addEventListener('dragend', () => {
        card.style.opacity = '1';
        draggedCard = null;
      });
      card.addEventListener('click', () => {
        const playerId = card.dataset.playerId;
        this.showPlayerActions(playerId);
      });
    });
    table.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
    });
    table.addEventListener('drop', (e) => {
      e.preventDefault();
      if (!draggedCard) return;
      const rect = table.getBoundingClientRect();
      const x = Math.max(0, Math.min(e.clientX - rect.left - offsetX, rect.width - 100));
      const y = Math.max(0, Math.min(e.clientY - rect.top - offsetY, rect.height - 130));
      draggedCard.style.left = `${x}px`;
      draggedCard.style.top = `${y}px`;
    });
  }
  applyTableAutozoom() {
    const mapZone = document.getElementById('gmNightMapZone');
    const container = document.getElementById('gmTableContainer');
    if (!mapZone || !container) return;
    setTimeout(() => {
      const availableWidth = mapZone.offsetWidth;
      const availableHeight = mapZone.offsetHeight;
      // Calculer les limites de tous les joueurs pour le vrai bounding box
      let minX = Infinity, maxX = -Infinity;
      let minY = Infinity, maxY = -Infinity;
      // Support both assignRoles and playing modes
      const playerPoints = document.querySelectorAll('#gmPlayersAssignContainer .gm-player-point, #gmFirstNightPlayersContainer .gm-night-player');
      playerPoints.forEach(point => {
        const x = parseInt(point.style.left) || 0;
        const y = parseInt(point.style.top) || 0;
        minX = Math.min(minX, x);
        maxX = Math.max(maxX, x + 16); // 16px pour la taille du point
        minY = Math.min(minY, y);
        maxY = Math.max(maxY, y + 16);
      });
      // Si pas de joueurs, utiliser la table
      if (minX === Infinity) {
        container.style.transform = 'scale(1)';
        return;
      }
      // Ajouter de la marge
      const width = maxX - minX + 40;
      const height = maxY - minY + 40;
      // Calculer le zoom en priorit sur la largeur
      const zoomX = (availableWidth * 0.9) / width;
      const zoomY = (availableHeight * 0.9) / height;
      // Donner la priorit  la largeur - utiliser zoomX en priorit
      const zoom = zoomX;
      const finalZoom = Math.max(Math.min(zoom, 1.5), 0.2);
      container.style.transform = `scale(${finalZoom})`;
    }, 100);
  }
  setupFirstNightResizable() {
    // === HORIZONTAL RESIZE DSACTIV (50/50 layout fixe) ===
    // La table reste  50%  gauche, les infos  50%  droite - PAS DE RESIZABLE
    // === VERTICAL RESIZE (zone narrative vs interactions) ===
    const textZone = document.getElementById('gmNightTextZone');
    const vHandle = document.querySelector('#gmNightTextZone + .gm-resize-handle');
    if (textZone && vHandle && !vHandle._vListeners) {
      vHandle._vListeners = true;
      const parentContainer = vHandle.parentElement;
      vHandle.addEventListener('mousedown', (e) => {
        window._gmResize = window._gmResize || {};
        window._gmResize.vResizing = true;
        window._gmResize.vStart = e.clientY;
        window._gmResize.vHeight = textZone.getBoundingClientRect().height;
        vHandle.style.opacity = '1';
        e.preventDefault();
      });
      vHandle.addEventListener('mouseenter', () => {
        vHandle.style.opacity = '0.8';
      });
      vHandle.addEventListener('mouseleave', () => {
        if (!window._gmResize?.vResizing) vHandle.style.opacity = '0.5';
      });
    }
    // === GLOBAL EVENTS (une seule fois) ===
    if (!window._gmResizeGlobal) {
      window._gmResizeGlobal = true;
      const self = this;
      document.addEventListener('mousemove', (e) => {
        // Redimensionner VERTICALEMENT (zone narrative vs interactions)
        if (window._gmResize?.vResizing) {
          const textZoneEl = document.getElementById('gmNightTextZone');
          if (textZoneEl) {
            const parentContainer = textZoneEl.parentElement;
            const delta = e.clientY - window._gmResize.vStart;
            const newHeight = Math.max(60, Math.min(window._gmResize.vHeight + delta, parentContainer.offsetHeight - 100));
            const percent = Math.min(Math.max((newHeight / parentContainer.offsetHeight) * 100, 15), 85);
            textZoneEl.style.setProperty('flex', `0 0 ${percent}%`, 'important');
            // Table  taille FIXE - pas de recalcul
            // setTimeout(() => self.applyTableAutozoom(), 0);
          }
        }
      });
      document.addEventListener('mouseup', () => {
        if (window._gmResize?.vResizing) {
          self.gm.saveState();
        }
        window._gmResize = window._gmResize || {};
        window._gmResize.vResizing = false;
        const vHandle = document.querySelector('#gmNightTextZone + .gm-resize-handle');
        if (vHandle) vHandle.style.opacity = '0.5';
      });
    }
  }
  setupAssignRolesDragDrop() {
    const container = document.getElementById('gmPlayersAssignContainer');
    if (!container) return;
    let draggedPoint = null;
    let draggedPlayerId = null;
    let offsetX = 0;
    let offsetY = 0;
    const self = this;
    // Utiliser event delegation sur le conteneur
    container.addEventListener('dragstart', (e) => {
      if (!e.target.closest('.gm-player-point')) return;
      draggedPoint = e.target.closest('.gm-player-point');
      draggedPlayerId = draggedPoint.dataset.playerId;
      offsetX = e.clientX - draggedPoint.getBoundingClientRect().left;
      offsetY = e.clientY - draggedPoint.getBoundingClientRect().top;
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setDragImage(new Image(), 0, 0);
      draggedPoint.style.opacity = '0.5';
    });
    container.addEventListener('dragend', (e) => {
      if (draggedPoint) {
        draggedPoint.style.opacity = '1';
      }
      draggedPoint = null;
      draggedPlayerId = null;
    });
    container.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
    });
    container.addEventListener('drop', (e) => {
      e.preventDefault();
      if (!draggedPoint || !draggedPlayerId) return;
      const rect = container.getBoundingClientRect();
      const x = e.clientX - rect.left - offsetX;
      const y = e.clientY - rect.top - offsetY;
      // Permettre les positions autour de la table
      const maxX = rect.width - 16;
      const maxY = rect.height - 16;
      const finalX = Math.max(0, Math.min(x, maxX));
      const finalY = Math.max(0, Math.min(y, maxY));
      draggedPoint.style.left = `${finalX}px`;
      draggedPoint.style.top = `${finalY}px`;
      // Sauvegarder la position du joueur
      const player = self.gm.state.players.find(p => p.id === draggedPlayerId);
      if (player) {
        player.tableX = finalX;
        player.tableY = finalY;
        self.gm.saveState();
        // Table  taille FIXE - pas de zoom auto!
        // setTimeout(() => self.applyTableAutozoom(), 0);
      }
    });
  }
  setupTableResizable() {
    const handle = document.getElementById('gmTableResizeHandle');
    const table = document.getElementById('gmTableResize');
    if (!handle || !table) return;
    let isResizing = false;
    let startX = 0;
    let startY = 0;
    let startWidth = 0;
    let startHeight = 0;
    handle.addEventListener('mousedown', (e) => {
      isResizing = true;
      startX = e.clientX;
      startY = e.clientY;
      startWidth = table.offsetWidth;
      startHeight = table.offsetHeight;
      handle.style.opacity = '1';
      e.preventDefault();
    });
    handle.addEventListener('mouseenter', () => {
      handle.style.opacity = '0.8';
    });
    handle.addEventListener('mouseleave', () => {
      if (!isResizing) handle.style.opacity = '0.5';
    });
    document.addEventListener('mousemove', (e) => {
      if (!isResizing) return;
      const deltaX = e.clientX - startX;
      const deltaY = e.clientY - startY;
      const newWidth = Math.max(80, startWidth + deltaX);
      const newHeight = Math.max(80, startHeight + deltaY);
      table.style.width = newWidth + 'px';
      table.style.height = newHeight + 'px';
    });
    document.addEventListener('mouseup', () => {
      if (isResizing) {
        handle.style.opacity = '0.5';
        this.gm.saveState();
      }
      isResizing = false;
    });
  }
