      const role = this.gm.roles[p.roleId];
      return `
        <div style="background:rgba(255,255,255,0.08); padding:8px; border-radius:6px; margin-bottom:6px; display:flex; align-items:center; gap:8px; cursor:pointer; transition:all 0.2s;" class="gm-day-player-vote" data-player-id="${p.id}">
          <div style="font-size:20px;">${role?.icon || '?'}</div>
          <div>
            <div style="font-weight:600; font-size:12px;">${p.name}</div>
            <div style="font-size:10px; opacity:0.6;">${p.roleId || 'Non assign'}</div>
          </div>
        </div>
      `;
