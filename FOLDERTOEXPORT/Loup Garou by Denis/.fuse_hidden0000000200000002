  // ===== DYNAMIC LISTENERS =====
  attachDynamicListeners() {
    // Setup
    const btnNewGame = document.getElementById('gmBtnNewGame');
    if (btnNewGame) {
      console.log('[GameMaster UI] gmBtnNewGame found, attaching listener');
      btnNewGame.addEventListener('click', () => {
        console.log('[GameMaster UI] gmBtnNewGame clicked!');
        this.gm.resetState();
        this.gm.state.mode = 'selectRoles';
        this.gm.state.players = [];
        this.gm.state.selectedRoles = [];
        this.gm.saveState();
        console.log('[GameMaster UI] Mode changed to selectRoles');
        this.render();
      });
    } else {
      console.warn('[GameMaster UI] gmBtnNewGame not found!');
    }
    // Crer la bulle de tooltip une seule fois
    let tooltipBubble = document.getElementById('gmTooltipBubble');
    if (!tooltipBubble) {
      tooltipBubble = document.createElement('div');
      tooltipBubble.id = 'gmTooltipBubble';
      tooltipBubble.className = 'gm-tooltip-bubble';
      document.body.appendChild(tooltipBubble);
    }
    // Deck cards - retirer une carte au clic
    document.querySelectorAll('.gm-deck-card')?.forEach(card => {
      card.addEventListener('click', (e) => {
        const roleId = card.getAttribute('data-deck-role-id');
        console.log('[GameMaster UI] Deck card clicked, removing:', roleId);
        // Sauvegarder la position du scroll
        const rolesContainer = document.querySelector('.gm-roles-container');
        const scrollPos = rolesContainer ? rolesContainer.scrollTop : 0;
        // Retirer la premire occurrence du rle
        const idx = this.gm.state.selectedRoles.indexOf(roleId);
        if (idx !== -1) {
          this.gm.state.selectedRoles.splice(idx, 1);
        }
        this.gm.saveState();
        this.render();
        // Restaurer la position du scroll
        setTimeout(() => {
          const container = document.querySelector('.gm-roles-container');
          if (container) {
            container.scrollTop = scrollPos;
          }
        }, 0);
      });
    });
    // Select Roles - avec cartes visuelles
    document.querySelectorAll('[data-role-id]')?.forEach(card => {
      // Click listener - ajoute la carte (permet les doublons)
      card.addEventListener('click', (e) => {
        const roleId = card.dataset.roleId;
        console.log('[GameMaster UI] Role clicked:', roleId);
        // Sauvegarder la position du scroll
        const rolesContainer = document.querySelector('.gm-roles-container');
        const scrollPos = rolesContainer ? rolesContainer.scrollTop : 0;
        this.gm.state.selectedRoles.push(roleId);
        this.gm.saveState();
        this.render();
        // Restaurer la position du scroll
        setTimeout(() => {
          const container = document.querySelector('.gm-roles-container');
          if (container) {
            container.scrollTop = scrollPos;
          }
        }, 0);
      });
      // Tooltip hover listeners
      card.addEventListener('mouseenter', (e) => {
        const description = card.getAttribute('data-description');
        if (description) {
          tooltipBubble.textContent = description;
          const rect = card.getBoundingClientRect();
          const x = rect.left + rect.width / 2;
          const y = rect.top - 15;
          tooltipBubble.style.left = Math.max(10, Math.min(x - 150, window.innerWidth - 320)) + 'px';
          tooltipBubble.style.top = (y - 80) + 'px';
          tooltipBubble.classList.add('visible');
        }
      });
      card.addEventListener('mouseleave', () => {
        tooltipBubble.classList.remove('visible');
      });
    });
    document.getElementById('gmBtnBackSelectRoles')?.addEventListener('click', () => {
      this.gm.state.mode = 'setup';
      this.gm.saveState();
      this.render();
    });
    document.getElementById('gmBtnContinuePlayers')?.addEventListener('click', () => {
      if (this.gm.state.selectedRoles.length < 2) {
        alert('Slectionnez au minimum 2 rles!');
        return;
      }
      // Go directly to tableSetup (skip the players screen)
      this.gm.state.mode = 'tableSetup';
      this.gm.saveState();
      this.render();
    });
    // Players
    document.getElementById('gmBtnAddPlayer')?.addEventListener('click', () => {
      const cardsCount = this.gm.state.selectedRoles.length;
      if (this.gm.state.players.length >= cardsCount) {
        alert(`Vous avez dj ${cardsCount} joueurs pour ${cardsCount} cartes!`);
        return;
      }
      const name = `Joueur ${this.gm.state.players.length + 1}`;
      this.gm.addPlayer(name);
      this.render();
    });
    document.getElementById('gmBtnRemoveLastPlayer')?.addEventListener('click', () => {
      if (this.gm.state.players.length > 0) {
        const lastPlayer = this.gm.state.players[this.gm.state.players.length - 1];
        this.gm.removePlayer(lastPlayer.id);
        this.render();
      }
    });
    // Sauvegarder les noms en temps rel (sans reset)
    document.querySelectorAll('.gm-player-name-input')?.forEach(input => {
      input.addEventListener('input', (e) => {
        const playerId = e.target.dataset.playerId;
        const player = this.gm.state.players.find(p => p.id === playerId);
        if (player) {
          player.name = e.target.value;
          this.gm.saveState();
        }
