# =========================================
#  CONTENU UTILISATEUR (mp3 perso, covers générées)
#  -> chacun son contenu, on partage que le code/template
# =========================================
music/*
sfx/*
covers/*
!music/.gitkeep
!sfx/.gitkeep
!covers/.gitkeep

# =========================================
#  BUILD OUTPUTS (régénérés à chaque build/scan)
# =========================================
FOLDERTOEXPORT/
output.html

# =========================================
#  CONFIG LOCAL (généré au scan, propre à chaque projet)
# =========================================
config.json

# =========================================
#  PYTHON
# =========================================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.python-version

# =========================================
#  OS / IDE
# =========================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# =========================================
#  Anciens fichiers (à la racine, non utilisés)
#  scan_files.py / build_config.py / build_html.py à la racine
#  sont legacy et peuvent être supprimés manuellement.
# =========================================
